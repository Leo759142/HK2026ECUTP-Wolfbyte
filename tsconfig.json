{
	"compilerOptions": {
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "es2022"
	},
	"extends": "$app/tsconfig",
	"include": ["src/**/*.d.ts", "src/**/*.ts", "src/**/*.svelte", "vite.config.ts"],
	"exclude": [
		"temp",
		"docs",
		"node_modules",
		".svelte-kit",
		"dist",
		"build",
		"backup_frontend_react",
		"src/service-worker"
	]
}
