{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": [
			"$app/types",
			"node"
		],
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include":["src","vite.config.ts","prettier.config.js","eslint.config.js"], "exclude": ["temp", "node_modules", ".svelte-kit", "src/service-worker"]
}
