2. Utilidad Matemática Haversine (src/lib/utils/distance.ts)

import type { Coordinates } from '$lib/types/poi.types';

// Calcula distancia en kilómetros entre dos coordenadas
export function calculateDistance(coord1: Coordinates, coord2: Coordinates): number {
  const R = 6371; // Radio de la Tierra en km
  const dLat = ((coord2.lat - coord1.lat) * Math.PI) / 180;
  const dLon = ((coord2.lng - coord1.lng) * Math.PI) / 180;
  const a =
    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos((coord1.lat * Math.PI) / 180) *
      Math.cos((coord2.lat * Math.PI) / 180) *
      Math.sin(dLon / 2) *
      Math.sin(dLon / 2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  return Number((R * c).toFixed(2));
}

3. Servicio de Geolocalización Híbrida (src/lib/services/geoService.ts)

import type { UserLocation } from '$lib/types/poi.types';

export class GeoLocationService {
  // 1. Obtener ubicación precisa por GPS
  public static async getGpsLocation(): Promise<UserLocation> {
    return new Promise((resolve, reject) => {
      if (!('geolocation' in navigator)) {
        return reject(new Error('Geolocalización no soportada por el navegador.'));
      }

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          resolve({
            coords: {
              lat: pos.coords.latitude,
              lng: pos.coords.longitude,
              accuracy: pos.coords.accuracy
            },
            provider: 'gps',
            timestamp: pos.timestamp
          });
        },
        (err) => reject(err),
        { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 }
      );
    });
  }

  // 2. Fallback de geolocalización aproximada por IP (con API pública)
  public static async getIpLocation(): Promise<UserLocation> {
    const res = await fetch('https://ipapi.co/json/');
    if (!res.ok) throw new Error('No se pudo determinar la ubicación por IP');
    const data = await res.json();
    return {
      coords: {
        lat: data.latitude,
        lng: data.longitude,
        accuracy: 10000 // Exactitud estimada de ~10km por IP
      },
      provider: 'ip',
      timestamp: Date.now()
    };
  }
}

4. Servicio CRUD con localStorage (src/lib/services/poiService.ts)

import { writable } from 'svelte/store';
import type { POI } from '$lib/types/poi.types';

const STORAGE_KEY = 'geo_pois_v1';

const initialPois: POI[] = [
  {
    id: '1',
    name: 'Café & Panadería Central',
    category: 'food',
    description: 'El mejor café de especialidad y brunch.',
    coords: { lat: -12.046374, lng: -77.042793 },
    rating: 5,
    createdAt: Date.now()
  },
  {
    id: '2',
    name: 'Supermercado Orgánico',
    category: 'shop',
    description: 'Frutas, verduras frescas y productos locales.',
    coords: { lat: -12.049374, lng: -77.045793 },
    rating: 4,
    createdAt: Date.now()
  }
];

function createPoiStore() {
  const isBrowser = typeof window !== 'undefined';
  let stored: POI[] = initialPois;

  if (isBrowser) {
    const item = localStorage.getItem(STORAGE_KEY);
    stored = item ? JSON.parse(item) : initialPois;
  }

  const { subscribe, set, update } = writable<POI[]>(stored);

  const persist = (pois: POI[]) => {
    if (isBrowser) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(pois));
    }
    set(pois);
  };

  return {
    subscribe,
    create: (poi: Omit<POI, 'id' | 'createdAt'>) => {
      const newPoi: POI = {
        ...poi,
        id: crypto.randomUUID(),
        createdAt: Date.now()
      };
      update((pois) => {
        const updated = [newPoi, ...pois];
        persist(updated);
        return updated;
      });
      return newPoi;
    },
    update: (id: string, updatedFields: Partial<POI>) => {
      update((pois) => {
        const updated = pois.map((p) => (p.id === id ? { ...p, ...updatedFields } : p));
        persist(updated);
        return updated;
      });
    },
    delete: (id: string) => {
      update((pois) => {
        const updated = pois.filter((p) => p.id !== id);
        persist(updated);
        return updated;
      });
    }
  };
}

export const poiStore = createPoiStore();

5. Componente del Mapa con Leaflet (src/lib/components/Map.svelte)

Importante para SvelteKit: Leaflet accede directamente al DOM (window). Debe ser
importado dinámicamente solo en el cliente (browser).

<script lang="ts">
  import { onMount, onDestroy } from 'svelte';
  import { browser } from '$app/environment';
  import type { POI, UserLocation } from '$lib/types/poi.types';
  import 'leaflet/dist/leaflet.css';

  export let userLocation: UserLocation | null = null;
  export let pois: POI[] = [];
  export let onMapClick: ((coords: { lat: number; lng: number }) => void) | undefined = undefined;

  let mapContainer: HTMLDivElement;
  let L: typeof import('leaflet');
  let mapInstance: import('leaflet').Map;
  let markersLayer: import('leaflet').LayerGroup;

  const categoryIcons: Record<string, { emoji: string; color: string }> = {
    food: { emoji: '🍔', color: '#f59e0b' },
    shop: { emoji: '🛍️', color: '#3b82f6' },
    leisure: { emoji: '🎉', color: '#ec4899' },
    health: { emoji: '💊', color: '#10b981' },
    service: { emoji: '🔧', color: '#6366f1' }
  };

  onMount(async () => {
    if (!browser) return;
    L = await import('leaflet');

    // Inicializar mapa centrado por defecto
    const defaultCenter: [number, number] = userLocation
      ? [userLocation.coords.lat, userLocation.coords.lng]
      : [0, 0];

    mapInstance = L.map(mapContainer).setView(defaultCenter, 15);

    // Tiles de OpenStreetMap
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(mapInstance);

    markersLayer = L.layerGroup().addTo(mapInstance);

    // Listener para registrar POIs al clickear
    mapInstance.on('click', (e: import('leaflet').LeafletMouseEvent) => {
      if (onMapClick) {
        onMapClick({ lat: e.latlng.lat, lng: e.latlng.lng });
      }
    });

    renderMarkers();
  });

  $: if (mapInstance && (pois || userLocation)) {
    renderMarkers();
  }

  function renderMarkers() {
    if (!mapInstance || !L || !markersLayer) return;
    markersLayer.clearLayers();

    // 1. Marcador de usuario
    if (userLocation) {
      const userIcon = L.divIcon({
        className: 'user-pin',
        html: `<div class="pulse-marker" title="Tu posición (${userLocation.provider})">📍</div>`,
        iconSize: [32, 32],
        iconAnchor: [16, 32]
      });

      L.marker([userLocation.coords.lat, userLocation.coords.lng], { icon: userIcon })
        .addTo(markersLayer)
        .bindPopup(`<b>Estás aquí</b><br>Fuente: ${userLocation.provider.toUpperCase()}`);

      mapInstance.panTo([userLocation.coords.lat, userLocation.coords.lng]);
    }

    // 2. Marcadores POIs
    pois.forEach((poi) => {
      const cat = categoryIcons[poi.category] || { emoji: '📍', color: '#6b7280' };
      const customIcon = L.divIcon({
        className: 'poi-custom-pin',
        html: `<div style="background-color: ${cat.color};" class="poi-bubble">${cat.emoji}</div>`,
        iconSize: [36, 36],
        iconAnchor: [18, 36]
      });

      const marker = L.marker([poi.coords.lat, poi.coords.lng], { icon: customIcon }).addTo(markersLayer);
      marker.bindPopup(`
        <div class="popup-content">
          <strong style="font-size: 1.1em;">${poi.name}</strong>
          <p style="margin: 4px 0;">${poi.description}</p>
          <small>Categoría: ${poi.category.toUpperCase()} | Calificación: ⭐ ${poi.rating}/5</small>
        </div>
      `);
    });
  }

  onDestroy(() => {
    if (mapInstance) mapInstance.remove();
  });
</script>

