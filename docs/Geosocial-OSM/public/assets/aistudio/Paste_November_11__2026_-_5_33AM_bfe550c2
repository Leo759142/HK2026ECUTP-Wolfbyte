6. Vista Principal (src/routes/+page.svelte)

Integra el selector permisivo de ubicación, visualización de mapa, filtrado por
categorías, cálculo Haversine y Web Share API.

<script lang="ts">
  import { onMount } from 'svelte';
  import Map from '$lib/components/Map.svelte';
  import { poiStore } from '$lib/services/poiService';
  import { GeoLocationService } from '$lib/services/geoService';
  import { calculateDistance } from '$lib/utils/distance';
  import type { POI, UserLocation, Category } from '$lib/types/poi.types';

  let userLocation: UserLocation | null = null;
  let permissionPromptOpen = false;
  let selectedCategory: Category | 'all' = 'all';
  let isOnline = true;

  // Formulario POI reactivo
  let newPoiName = '';
  let newPoiDesc = '';
  let newPoiCat: Category = 'food';
  let tempCoords: { lat: number; lng: number } | null = null;

  onMount(() => {
    isOnline = navigator.onLine;
    window.addEventListener('online', () => (isOnline = true));
    window.addEventListener('offline', () => (isOnline = false));

    // Determinar si ya tenemos ubicación o abrimos el diálogo de permisos
    checkOrAskPermissions();
  });

  async function checkOrAskPermissions() {
    try {
      // Intento primario: GPS móvil
      userLocation = await GeoLocationService.getGpsLocation();
    } catch {
      // Si el GPS falla o fue rechazado, abrimos modal para consultar IP
      permissionPromptOpen = true;
    }
  }

  async function acceptIpFallback() {
    permissionPromptOpen = false;
    try {
      userLocation = await GeoLocationService.getIpLocation();
    } catch (e) {
      alert('No se pudo obtener ubicación aproximada.');
    }
  }

  function handleMapClick(coords: { lat: number; lng: number }) {
    tempCoords = coords;
  }

  function savePoi() {
    if (!tempCoords || !newPoiName.trim()) return;
    poiStore.create({
      name: newPoiName,
      description: newPoiDesc,
      category: newPoiCat,
      coords: tempCoords,
      rating: 5
    });
    tempCoords = null;
    newPoiName = '';
    newPoiDesc = '';
  }

  async function sharePoi(poi: POI) {
    const text = `¡Mira este lugar: ${poi.name}! Categoria: ${poi.category}. Ubicación: https://www.openstreetmap.org/?mlat=${poi.coords.lat}&mlon=${poi.coords.lng}`;
    if (navigator.share) {
      await navigator.share({ title: poi.name, text });
    } else {
      await navigator.clipboard.writeText(text);
      alert('¡Enlace copiado al portapapeles!');
    }
  }

  // POIs ordenados por distancia reactivamente
  $: enrichedPois = $poiStore
    .filter((p) => selectedCategory === 'all' || p.category === selectedCategory)
    .map((p) => {
      const distance = userLocation ? calculateDistance(userLocation.coords, p.coords) : null;
      return { ...p, distance };
    })
    .sort((a, b) => (a.distance ?? Infinity) - (b.distance ?? Infinity));
</script>

