# ==================================================================
#  AYNI · Backend (SvelteKit). Copia este archivo como backend/.env
#  Nunca subas backend/.env al repositorio (está en .gitignore).
# ==================================================================

# --- Base de datos (OBLIGATORIA) -----------------------------------
# PostgreSQL 13 o superior. Crea la base primero:  createdb -U postgres ayni
# Formato: postgres://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgres://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/ayni
PG_POOL_MAX=10
# Base SOLO para tests (npm test la VACÍA en cada corrida). Nunca la de producción.
TEST_DATABASE_URL=postgres://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/ayni_test

# --- Seguridad -----------------------------------------------------
# Obligatorio en producción (mínimo 32 caracteres aleatorios):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AYNI_SECRETO=
SESION_DIAS=30
# true en producción (HTTPS). Por defecto: true si NODE_ENV=production.
COOKIE_SECURE=
# Orígenes externos que pueden llamar a la API (separados por coma).
# En desarrollo no hace falta: el frontend usa el proxy de Vite.
CORS_ORIGINS=

# --- Modo demostración --------------------------------------------
# true: código SMS fijo, datos de ejemplo y "Herramientas de demostración".
AYNI_DEMO=true
AYNI_OTP_DEMO=1234

# --- Reglas configurables -----------------------------------------
CONFIRMACIONES_REQUERIDAS=1
VISTOS_BUENOS_PARA_GUARDIAN=0
