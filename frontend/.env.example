# AYNI · Frontend. Copia como frontend/.env si necesitas cambiar algo.
# Aquí NO van secretos: lo que empieza con VITE_ queda visible en el navegador.
# Dónde está el backend (proxy de desarrollo y vista previa).
AYNI_BACKEND_URL=http://localhost:5180
# Solo si la app se publica en OTRO dominio que la API. Vacío = misma URL (/api/v1).
VITE_API_URL=
