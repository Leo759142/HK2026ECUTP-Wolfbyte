{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"moduleResolution": "bundler",
		"module": "esnext",
		"target": "esnext",
		"checkJs": false,
		"strict": false,
		"baseUrl": ".",
		"paths": {
			"$lib": ["src/lib"],
			"$lib/*": ["src/lib/*"]
		}
	},
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"]
}